# Copy to .env for local development. .env is gitignored and must stay that way.

INSIGHTS_TENANT_ID=people-analytics

# Assigned by the platform team, not chosen here (ADR-2). Restricted tier means
# the app will not start with an unscoped route, and that an access which cannot
# be audited is refused with a 503 rather than served. Both are deliberate: this
# tenant is less available than a standard-tier one, by design.
INSIGHTS_TIER=restricted

INSIGHTS_IDP_URL=http://localhost:8081
INSIGHTS_WAREHOUSE_URL=http://localhost:8082
INSIGHTS_AUDIT_URL=http://localhost:8083

# Local development only. The stub IdP signs with a shared secret; real
# deployments verify against the corporate IdP's published keys and leave this
# unset. Set in a deployed environment, it is an incident.
# INSIGHTS_TOKEN_SECRET=dev-only-insecure-secret-replaced-by-the-idp-in-any-real-deployment
